{
  "name": "tmon",
  "version": "0.1.0",
  "description": "AI Agent 命令执行追踪与监控工具",
  "type": "module",
  "bin": {
    "tmon": "bin/tmon.js"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "web/dist",
    "docs",
    "skills",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --outfile=dist/cli.js --external:node-pty --external:ws --external:iconv-lite --log-level=warning",
    "web:dev": "cd web && npm run dev",
    "prepack": "npm run build && cd web && npm run build"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "iconv-lite": "^0.6.3",
    "node-pty": "^1.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  }
}
